#!/usr/bin/env bash
# pre-commit-bib — Git pre-commit hook（上記を呼ぶ）
# pre-commit hook: auto-fix non-LaTeX characters in LaTeX source files.
#
# Canonical location: claude-config/scripts/pre-commit-bib
# Installed by setup.sh to .git/hooks/pre-commit in repos containing
# LaTeX files (.tex, .bib, .bst, .cls, .sty).
#
# The fixer script (fix-bib-unicode.py) is resolved relative to this file
# when symlinked, or falls back to ~/Claude/claude-config/scripts/.
#
# Opt-out: vendored / verbatim third-party LaTeX can be excluded from the
# auto-fix by unsetting the `latex-autofix` attribute in .gitattributes, e.g.
#     notes/vendor/** -latex-autofix
# Such paths are committed byte-for-byte (the layer-3 chain hook still runs).

set -euo pipefail

# Locate fix-bib-unicode.py:
#   1. Follow symlink to find the canonical scripts/ directory
#   2. Fall back to ~/Claude/claude-config/scripts/
SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
SCRIPTS_DIR="$(cd "$(dirname "$SELF")" && pwd)"
FIXER="$SCRIPTS_DIR/fix-bib-unicode.py"

if [[ ! -f "$FIXER" ]]; then
    # Fallback for Windows (cp install) where readlink may not resolve
    FIXER="$HOME/Claude/claude-config/scripts/fix-bib-unicode.py"
fi

# LaTeX Unicode fix — runs only when the fixer exists AND LaTeX files are staged.
# CRITICAL: do NOT early-exit on "no fixer" / "no LaTeX files". The layer-3
# custom hook chain below must run on EVERY commit (incl. pure non-LaTeX, e.g.
# yaml-only commits), otherwise data/yaml gates silently never fire. (2026-06-06
# RCA: a refs.yaml-only commit with a duplicate was NOT rejected because this
# early-exit skipped the custom hook.)
if [[ -f "$FIXER" ]]; then
    LATEX_FILES=$(git diff --cached --name-only --diff-filter=ACM \
        | grep -E '\.(tex|bib|bst|cls|sty)$' || true)
    # Opt-out for vendored / verbatim third-party LaTeX: a path whose
    # `latex-autofix` git attribute is unset (via .gitattributes, e.g.
    #     path/to/vendored/** -latex-autofix
    # ) is excluded here so its bytes are preserved exactly. Paths without
    # the attribute are auto-fixed as before (= backward compatible default).
    KEPT=""
    for f in $LATEX_FILES; do
        attr=$(git check-attr latex-autofix -- "$f" 2>/dev/null | sed 's/.*: //' || true)
        [[ "$attr" == "unset" ]] && continue
        KEPT="$KEPT $f"
    done
    LATEX_FILES="$KEPT"

    if [[ -n "${LATEX_FILES// /}" ]]; then
        # Run the fixer (exit 1 = files were modified, 0 = no changes)
        python3 "$FIXER" $LATEX_FILES && rc=0 || rc=$?
        if [[ $rc -eq 1 ]]; then
            for f in $LATEX_FILES; do
                git add "$f"
            done
            echo "pre-commit: auto-fixed non-LaTeX characters and re-staged."
        elif [[ $rc -ge 2 ]]; then
            echo "pre-commit: fix-bib-unicode.py failed (exit $rc)." >&2
            exit 1
        fi
    fi
else
    echo "pre-commit: fix-bib-unicode.py not found. Skipping LaTeX check." >&2
fi

# Merge conflict marker gate — この commit で触る file の staged 内容に行頭 conflict
# marker が残っていれば BLOCK。 検出 logic / escape hatch / 設計動機 (2026-07-10 実事故)
# の SoT = lib/staged-conflict-markers.sh header。 lib 不在 (= Windows cp 設置の古い
# 環境等) は warn + skip (= fail-open、 hook 全体を壊さない)。
CONFLICT_LIB="$SCRIPTS_DIR/lib/staged-conflict-markers.sh"
[[ -f "$CONFLICT_LIB" ]] || CONFLICT_LIB="$HOME/Claude/claude-config/scripts/lib/staged-conflict-markers.sh"
if [[ -f "$CONFLICT_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$CONFLICT_LIB"
    if ! check_staged_conflict_markers; then
        exit 1
    fi
else
    echo "pre-commit: staged-conflict-markers.sh not found. Skipping conflict-marker gate." >&2
fi

# 原稿の主張と agent の権限規約の gate (AI agent の session の commit だけを見る。 人の commit は通す)。
# 保護領域 (表題・概要・序論・結論・数式) と権限規約の、 著者の項目ごとの承認 (著者の発言の verbatim を
# transcript で照合したもの) の無い変更を止める。 Claude / Codex の PreToolUse hook と同じ engine・同じ述語。
# 止めるのは「exit 1 かつ engine の見出し」 のときだけ (= engine の内部エラーで全 commit を止めない)。
# 正本 = conventions/manuscript-claim-ownership.md
MCG_ENGINE="$SCRIPTS_DIR/manuscript-claim-guard.py"
[[ -f "$MCG_ENGINE" ]] || MCG_ENGINE="$HOME/Claude/claude-config/scripts/manuscript-claim-guard.py"
if [[ -f "$MCG_ENGINE" ]] && command -v python3 >/dev/null 2>&1; then
    mcg_rc=0
    mcg_out="$(python3 "$MCG_ENGINE" git-precommit 2>&1)" || mcg_rc=$?
    [[ -n "$mcg_out" ]] && printf '%s\n' "$mcg_out" >&2
    if [[ $mcg_rc -eq 1 ]] && printf '%s' "$mcg_out" | grep -q 'manuscript-claim-guard:'; then
        exit 1
    fi
fi

# root AGENTS.md の入口が無い repo を知らせる (止めない、 SoT = lib/agents-entrypoint-warn.sh header)。
AGENTS_WARN_LIB="$SCRIPTS_DIR/lib/agents-entrypoint-warn.sh"
[[ -f "$AGENTS_WARN_LIB" ]] || AGENTS_WARN_LIB="$HOME/Claude/claude-config/scripts/lib/agents-entrypoint-warn.sh"
if [[ -f "$AGENTS_WARN_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$AGENTS_WARN_LIB"
    warn_missing_agents_entrypoint
fi

# Optional chain to layer-3 (= personal layer) custom hook.
# odakin-prefs/scripts/pre-commit-yaml-scan.sh があれば呼ぶ。 他 user で本 file
# 不在なら silent skip (= layer 3 不在の他 Claude Code user の env に影響なし)。
# 詳細: ~/Claude/odakin-prefs/scripts/pre-commit-yaml-scan.sh
CUSTOM_HOOK="$HOME/Claude/odakin-prefs/scripts/pre-commit-yaml-scan.sh"
if [[ -x "$CUSTOM_HOOK" ]]; then
    "$CUSTOM_HOOK"  # set -e で exit 1 propagate
fi

exit 0
