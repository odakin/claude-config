#!/usr/bin/env bash
# pre-commit-bib — Git pre-commit hook（上記を呼ぶ）
# pre-commit hook: auto-fix non-LaTeX characters in LaTeX source files.
#
# Canonical location: claude-config/scripts/pre-commit-bib
# Installed by setup.sh to .git/hooks/pre-commit in repos containing
# LaTeX files (.tex, .bib, .bst, .cls, .sty).
#
# The fixer script (fix-bib-unicode.py) is resolved relative to this file
# when symlinked, or falls back to ~/Claude/claude-config/scripts/.
#
# Opt-out: vendored / verbatim third-party LaTeX can be excluded from the
# auto-fix by unsetting the `latex-autofix` attribute in .gitattributes, e.g.
#     notes/vendor/** -latex-autofix
# Such paths are committed byte-for-byte (the layer-3 chain hook still runs).

set -euo pipefail

# Locate fix-bib-unicode.py:
#   1. Follow symlink to find the canonical scripts/ directory
#   2. Fall back to ~/Claude/claude-config/scripts/
SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
SCRIPTS_DIR="$(cd "$(dirname "$SELF")" && pwd)"
FIXER="$SCRIPTS_DIR/fix-bib-unicode.py"

if [[ ! -f "$FIXER" ]]; then
    # Fallback for Windows (cp install) where readlink may not resolve
    FIXER="$HOME/Claude/claude-config/scripts/fix-bib-unicode.py"
fi

# LaTeX Unicode fix — runs only when the fixer exists AND LaTeX files are staged.
# CRITICAL: do NOT early-exit on "no fixer" / "no LaTeX files". The layer-3
# custom hook chain below must run on EVERY commit (incl. pure non-LaTeX, e.g.
# yaml-only commits), otherwise data/yaml gates silently never fire. (2026-06-06
# RCA: a refs.yaml-only commit with a duplicate was NOT rejected because this
# early-exit skipped the custom hook.)
if [[ -f "$FIXER" ]]; then
    LATEX_FILES=$(git diff --cached --name-only --diff-filter=ACM \
        | grep -E '\.(tex|bib|bst|cls|sty)$' || true)
    # Opt-out for vendored / verbatim third-party LaTeX: a path whose
    # `latex-autofix` git attribute is unset (via .gitattributes, e.g.
    #     path/to/vendored/** -latex-autofix
    # ) is excluded here so its bytes are preserved exactly. Paths without
    # the attribute are auto-fixed as before (= backward compatible default).
    KEPT=""
    for f in $LATEX_FILES; do
        attr=$(git check-attr latex-autofix -- "$f" 2>/dev/null | sed 's/.*: //' || true)
        [[ "$attr" == "unset" ]] && continue
        KEPT="$KEPT $f"
    done
    LATEX_FILES="$KEPT"

    if [[ -n "${LATEX_FILES// /}" ]]; then
        # Run the fixer (exit 1 = files were modified, 0 = no changes)
        python3 "$FIXER" $LATEX_FILES && rc=0 || rc=$?
        if [[ $rc -eq 1 ]]; then
            for f in $LATEX_FILES; do
                git add "$f"
            done
            echo "pre-commit: auto-fixed non-LaTeX characters and re-staged."
            # pathspec commit (git commit -- <path>) は一時 index で走る = 修正は commit に入るが、 main の index には修正前の版が残る
            # (commit の後に status が MM)。 直し方 = commit の後に git restore --staged <path> (latex.md#autofix-with-pathspec-commit)
            # --git-path index は GIT_INDEX_FILE を返すので使わない = git dir の index を直に見る
            main_index="$(git rev-parse --absolute-git-dir 2>/dev/null)/index"
            if [[ -n "${GIT_INDEX_FILE:-}" && -n "$main_index" && "$(cd "$(dirname "$GIT_INDEX_FILE")" 2>/dev/null && pwd)/$(basename "$GIT_INDEX_FILE")" != "$(cd "$(dirname "$main_index")" 2>/dev/null && pwd)/$(basename "$main_index")" ]]; then
                echo "pre-commit: pathspec commit — main の index に修正前の版が残る。 commit の後に git restore --staged$LATEX_FILES (latex.md#autofix-with-pathspec-commit)"
            fi
        elif [[ $rc -ge 2 ]]; then
            echo "pre-commit: fix-bib-unicode.py failed (exit $rc)." >&2
            exit 1
        fi
    fi
else
    echo "pre-commit: fix-bib-unicode.py not found. Skipping LaTeX check." >&2
fi

# Merge conflict marker gate — この commit で触る file の staged 内容に行頭 conflict
# marker が残っていれば BLOCK。 検出 logic / escape hatch / 設計動機 (2026-07-10 実事故)
# の SoT = lib/staged-conflict-markers.sh header。 lib 不在 (= Windows cp 設置の古い
# 環境等) は warn + skip (= fail-open、 hook 全体を壊さない)。
CONFLICT_LIB="$SCRIPTS_DIR/lib/staged-conflict-markers.sh"
[[ -f "$CONFLICT_LIB" ]] || CONFLICT_LIB="$HOME/Claude/claude-config/scripts/lib/staged-conflict-markers.sh"
if [[ -f "$CONFLICT_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$CONFLICT_LIB"
    if ! check_staged_conflict_markers; then
        exit 1
    fi
else
    echo "pre-commit: staged-conflict-markers.sh not found. Skipping conflict-marker gate." >&2
fi

# 原稿の主張と agent の権限規約の gate (AI agent の session の commit だけを見る。 人の commit は通す)。
# 保護領域 (表題・概要・序論・結論・数式) と権限規約の、 著者の項目ごとの承認 (著者の発言の verbatim を
# transcript で照合したもの) の無い変更を止める。 Claude / Codex の PreToolUse hook と同じ engine・同じ述語。
# agent の commit は検査不能でも止める。故障を許可に変えず修復して再検査する。
# 正本 = conventions/manuscript-claim-ownership.md
MCG_ENGINE="$SCRIPTS_DIR/manuscript-claim-guard.py"
[[ -f "$MCG_ENGINE" ]] || MCG_ENGINE="$HOME/Claude/claude-config/scripts/manuscript-claim-guard.py"
if [[ -n "${CLAUDE_CONFIG_AGENT_SESSION:-}${CLAUDE_CODE_SESSION_ID:-}${CODEX_SESSION_ID:-}${CODEX_THREAD_ID:-}" ]]; then
    if [[ ! -f "$MCG_ENGINE" ]] || ! command -v python3 >/dev/null 2>&1; then
        echo 'manuscript-claim-guard: inspection unavailable (engine/runtime missing); repair and retry.' >&2
        exit 1
    fi
    mcg_rc=0
    mcg_out="$(python3 "$MCG_ENGINE" git-precommit 2>&1)" || mcg_rc=$?
    [[ -n "$mcg_out" ]] && printf '%s\n' "$mcg_out" >&2
    if [[ $mcg_rc -ne 0 ]]; then
        echo 'manuscript-claim-guard: commit stopped; resolve the finding or inspection failure and retry.' >&2
        exit 1
    fi
fi

# script 置換の暴走で壊れた text の gate (1 行の異常な繰り返し / HEAD 比の爆発的な増加。 縮小は ⚠️ だけ)。
# 述語・閾値・escape hatch (CLAUDE_DEGENERATE_TEXT_GUARD=0) の SoT = scripts/check-degenerate-text.py docstring。
# 止めるのは「exit 1 かつ engine の見出し」 のときだけ (= engine の故障 〔rc 3〕 で全 commit を止めない)。
DGT_ENGINE="$SCRIPTS_DIR/check-degenerate-text.py"
[[ -f "$DGT_ENGINE" ]] || DGT_ENGINE="$HOME/Claude/claude-config/scripts/check-degenerate-text.py"
if [[ -f "$DGT_ENGINE" ]] && command -v python3 >/dev/null 2>&1; then
    dgt_rc=0
    dgt_out="$(python3 "$DGT_ENGINE" --staged 2>&1)" || dgt_rc=$?
    [[ -n "$dgt_out" ]] && printf '%s\n' "$dgt_out" >&2
    if [[ $dgt_rc -eq 1 ]] && printf '%s' "$dgt_out" | grep -q 'check-degenerate-text:'; then
        exit 1
    fi
fi

# shell script で波括弧の無い変数の直後に全角文字が続く形 ("$name、") の gate。 UTF-8 の locale では bash 3.2 が全角文字の
# 先頭 byte を変数名に取り込み、 set -u なら落ち、 無ければ値が黙って消える (C locale の手元と test では通る)。
# 述語・escape hatch (CLAUDE_UNBRACED_MB_VAR_GUARD=0) の SoT = scripts/check-unbraced-multibyte-var.py docstring、
# 規約 = conventions/shell-multibyte-truncation.md#unbraced-var-before-multibyte。
# 止めるのは「exit 1 かつ engine の BLOCK 見出し」 のときだけ。 見出しの無い非 0 (engine の異常終了) は 1 行出して通す。
UMV_ENGINE="$SCRIPTS_DIR/check-unbraced-multibyte-var.py"
[[ -f "$UMV_ENGINE" ]] || UMV_ENGINE="$HOME/Claude/claude-config/scripts/check-unbraced-multibyte-var.py"
if [[ -f "$UMV_ENGINE" ]] && command -v python3 >/dev/null 2>&1; then
    umv_rc=0
    umv_out="$(python3 "$UMV_ENGINE" --staged 2>&1)" || umv_rc=$?
    [[ -n "$umv_out" ]] && printf '%s\n' "$umv_out" >&2
    if [[ $umv_rc -eq 1 ]] && printf '%s' "$umv_out" | grep -q 'check-unbraced-multibyte-var: BLOCK'; then
        exit 1
    fi
    if [[ $umv_rc -ne 0 ]] && ! printf '%s' "$umv_out" | grep -q 'check-unbraced-multibyte-var:'; then
        echo "⚠️ pre-commit: 変数の直後の全角文字の検査が異常終了した (rc=${umv_rc}) — この commit では走っていない (commit は止めない)。 確認: python3 ${UMV_ENGINE} --selftest" >&2
    fi
fi

# 学生の識別子 (学籍番号の形・氏名・path の姓) を平文で新しく入れる commit の gate。 新しく入る path と、 平文の file の
# 足した行を見る (git-crypt で暗号化される file は index の blob が暗号文なので見ない)。 値の一覧は machine-local
# (~/.claude/student-identity.json + ~/.claude/pii-filename-patterns.txt)、 無い機械では何もしない。
# 述語・escape hatch (CLAUDE_STUDENT_ID_GUARD=0) の SoT = scripts/check-student-identifiers.py docstring。
# 止めるのは「exit 1 かつ engine の BLOCK 見出し」 のときだけ。 見出しの無い非 0 (engine の異常終了) は 1 行出して通す。
SID_ENGINE="$SCRIPTS_DIR/check-student-identifiers.py"
[[ -f "$SID_ENGINE" ]] || SID_ENGINE="$HOME/Claude/claude-config/scripts/check-student-identifiers.py"
if [[ -f "$SID_ENGINE" ]] && command -v python3 >/dev/null 2>&1; then
    sid_rc=0
    sid_out="$(python3 "$SID_ENGINE" --staged 2>&1)" || sid_rc=$?
    [[ -n "$sid_out" ]] && printf '%s\n' "$sid_out" >&2
    if [[ $sid_rc -eq 1 ]] && printf '%s' "$sid_out" | grep -q 'check-student-identifiers: BLOCK'; then
        exit 1
    fi
    if [[ $sid_rc -ne 0 ]] && ! printf '%s' "$sid_out" | grep -q 'check-student-identifiers:'; then
        echo "⚠️ pre-commit: 学生の識別子の検査が異常終了した (rc=${sid_rc}) — この commit では走っていない (commit は止めない)。 確認: python3 ${SID_ENGINE} --selftest" >&2
    fi
fi

# SESSION.md の形の gate (= 案件ごとの現在地 + 正本への link。 日付を見出しにした節・commit hash・messageId・経緯を詰めた
# 1 行・200 行を超えて育つ commit を止める。 README の自称正本 = 非公開 repo で止める / CLAUDE.md の「SESSION・README に書け」 = warn)。
# 述語・閾値・escape hatch (CLAUDE_SESSION_SHAPE_GUARD=0) の SoT = scripts/check-session-shape.py docstring、 規約 = CONVENTIONS.md#session-no-durable-record。
# 止めるのは「exit 1 かつ engine の見出し」 のときだけ (= engine の故障 〔rc 3〕 で全 commit を止めない)。
SSH_ENGINE="$SCRIPTS_DIR/check-session-shape.py"
[[ -f "$SSH_ENGINE" ]] || SSH_ENGINE="$HOME/Claude/claude-config/scripts/check-session-shape.py"
if [[ -f "$SSH_ENGINE" ]] && command -v python3 >/dev/null 2>&1; then
    ssh_rc=0
    ssh_out="$(python3 "$SSH_ENGINE" --staged 2>&1)" || ssh_rc=$?
    [[ -n "$ssh_out" ]] && printf '%s\n' "$ssh_out" >&2
    if [[ $ssh_rc -eq 1 ]] && printf '%s' "$ssh_out" | grep -q 'check-session-shape:'; then
        exit 1
    fi
fi

# 差分の効かない file (build した PDF・暗号化した台帳) の頻繁な commit と、 大きすぎる file を知らせる。
# 止めるのは GitHub が push を拒否する大きさ (1 file 100 MiB 超) だけ = 「exit 1 かつ engine の見出し」 のとき
# (engine の故障 〔rc 3〕 では止めない)。 閾値・判定の SoT = scripts/check-history-growth.py docstring、
# 対策の正本 = conventions/repo-history-growth.md。
HG_ENGINE="$SCRIPTS_DIR/check-history-growth.py"
[[ -f "$HG_ENGINE" ]] || HG_ENGINE="$HOME/Claude/claude-config/scripts/check-history-growth.py"
if [[ -f "$HG_ENGINE" ]] && command -v python3 >/dev/null 2>&1; then
    hg_rc=0
    hg_out="$(python3 "$HG_ENGINE" --staged 2>&1)" || hg_rc=$?
    [[ -n "$hg_out" ]] && printf '%s\n' "$hg_out" >&2
    if [[ $hg_rc -eq 1 ]] && printf '%s' "$hg_out" | grep -q 'check-history-growth: BLOCK'; then
        exit 1
    fi
fi

# 文中の節参照 (「path §「節名」」 / `path#anchor`) が実在する file の実在しない節を指していたら知らせる
# + この commit で消した見出しを他の file が指していたら知らせる。 止めない (exit 1 = 🔴 あり・警告済み、
# 3 = 検査が走っていない → 1 行出す)。 承知済み一覧は engine が各 repo root と個人層から読む。
# 述語・escape hatch (CLAUDE_TEXT_SECTION_REFS=0) の SoT = check-text-section-refs.py docstring、
# 一般則 = docs/convention-design-principles.md#text-section-refs。
TSR_ENGINE="$SCRIPTS_DIR/check-text-section-refs.py"
[[ -f "$TSR_ENGINE" ]] || TSR_ENGINE="$HOME/Claude/claude-config/scripts/check-text-section-refs.py"
if [[ -f "$TSR_ENGINE" ]] && command -v python3 >/dev/null 2>&1; then
    tsr_rc=0
    tsr_out="$(python3 "$TSR_ENGINE" --staged 2>&1)" || tsr_rc=$?
    [[ -n "$tsr_out" ]] && printf '%s\n' "$tsr_out" >&2
    if [[ $tsr_rc -ne 0 && $tsr_rc -ne 1 ]] && ! printf '%s' "$tsr_out" | grep -q 'check-text-section-refs:'; then
        echo "⚠️ pre-commit: 文中の節参照の検査が異常終了した (rc=${tsr_rc}) — この commit では走っていない (commit は止めない)。 確認: python3 ${TSR_ENGINE} --selftest" >&2
    fi
fi

# root AGENTS.md の入口が無い repo を知らせる (止めない、 SoT = lib/agents-entrypoint-warn.sh header)。
AGENTS_WARN_LIB="$SCRIPTS_DIR/lib/agents-entrypoint-warn.sh"
[[ -f "$AGENTS_WARN_LIB" ]] || AGENTS_WARN_LIB="$HOME/Claude/claude-config/scripts/lib/agents-entrypoint-warn.sh"
if [[ -f "$AGENTS_WARN_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$AGENTS_WARN_LIB"
    warn_missing_agents_entrypoint
fi

# Optional chain to layer-3 (= personal layer) custom hook.
# odakin-prefs/scripts/pre-commit-yaml-scan.sh があれば呼ぶ。 他 user で本 file
# 不在なら silent skip (= layer 3 不在の他 Claude Code user の env に影響なし)。
# 詳細: ~/Claude/odakin-prefs/scripts/pre-commit-yaml-scan.sh
CUSTOM_HOOK="$HOME/Claude/odakin-prefs/scripts/pre-commit-yaml-scan.sh"
if [[ -x "$CUSTOM_HOOK" ]]; then
    "$CUSTOM_HOOK"  # set -e で exit 1 propagate
fi

exit 0
